<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>🎂 Calendario de Cumpleaños - Familia Cuenca</title>
<style>
    body { font-family: Arial, sans-serif; background: #f8f9fa; text-align: center; }
    h1 { color: #ff4081; }
    table { margin: auto; border-collapse: collapse; }
    th, td { padding: 10px; border: 1px solid #ccc; }
    th { background: #ff4081; color: white; }
    td { background: #fff; }
    .hoy { background: #ffe082; font-weight: bold; }
    .btn { background: #25D366; color: white; padding: 8px 12px; text-decoration: none; border-radius: 5px; }
    .btn:hover { background: #1ebe5d; }
</style>
</head>
<body>
<h1>🎂 Calendario de Cumpleaños - Familia Cuenca</h1>
<p>Este calendario muestra las fechas de cumpleaños y permite enviar felicitaciones por WhatsApp.</p>
<table id="calendario">
    <tr><th>Nombre</th><th>Fecha</th><th>Acción</th></tr>
</table>
<script>
fetch('birthdays.json')
    .then(response => response.json())
    .then(data => {
        const hoy = new Date().toISOString().slice(5,10); // MM-DD
        const tabla = document.getElementById('calendario');
        data.forEach(c => {
            const fecha = c.fecha; // DD-MM
            const fechaInvertida = fecha.slice(3,5) + "-" + fecha.slice(0,2); // MM-DD
            let textoFecha = fecha;
            if (c.anio) {
                textoFecha += " (" + c.anio + ")";
            }
            let accion = "";
            if (fechaInvertida === hoy) {
                const mensaje = encodeURIComponent(`🎉 ¡Hoy celebramos a ${c.nombre}! 🎂 Que tengas un día lleno de alegría ❤️ - Familia Cuenca`);
                const enlaceGrupo = `https://wa.me/?text=${mensaje}`;
                accion = `<a class="btn" href="${enlaceGrupo}" target="_blank">Enviar Felicitación</a>`;
            }
            const fila = document.createElement('tr');
            fila.innerHTML = `<td>${c.nombre}</td><td class="${fechaInvertida === hoy ? 'hoy' : ''}">${textoFecha}</td><td>${accion}</td>`;
            tabla.appendChild(fila);
        });
    });
</script>
</body>
</html>
